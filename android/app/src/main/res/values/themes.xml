<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or dark as the phone is set (values-night has the dark one). -->
    <style name="Theme.Earshot" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The ringing screen: always dark, like a call. -->
    <style name="Theme.Earshot.Call" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/call_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
