<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds may also use plain http/ws, for a server running on your laptop on the same Wi-Fi. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Deliberate, debug builds only: release builds are TLS-only (src/main). -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
