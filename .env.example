# Copy to .env and fill in. Used by docker-compose.yml.

# Your domain, pointing at this machine (needed for the "https" and "turn" profiles).
EARSHOT_DOMAIN=calls.example.com

# Optional TURN relay. Generate a secret with: openssl rand -hex 32
TURN_SECRET=
TURN_URLS=turn:calls.example.com:3478?transport=udp,turn:calls.example.com:3478?transport=tcp
